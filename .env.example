# ============================================================
# 楽天ROOM 自動投稿システム - 環境変数設定ファイル
# このファイルを .env にコピーして値を入力してください
# cp .env.example .env
# ============================================================

# 楽天ウェブサービス (https://webservice.rakuten.co.jp/)
RAKUTEN_APP_ID=ここに楽天アプリIDを入力
RAKUTEN_ACCESS_KEY=ここに楽天アクセスキーを入力
RAKUTEN_AFFILIATE_ID=ここに楽天アフィリエイトIDを入力

# Anthropic API (https://console.anthropic.com/)
ANTHROPIC_API_KEY=ここにAnthropicAPIキーを入力

# Chatwork API (https://www.chatwork.com/service/packages/chatwork/subpackages/api/token.php)
CHATWORK_API_KEY=ここにChatworkAPIキーを入力

# 求人ボックス 企業アカウント (https://kyujinbox.com/)
KYUJINBOX_EMAIL=ここに求人ボックスのメールアドレスを入力
KYUJINBOX_PASSWORD=ここに求人ボックスのパスワードを入力
